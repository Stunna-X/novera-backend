# Application
APP_NAME=Novera
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
ENABLE_API_DOCS=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/novera
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=novera
JWT_AUDIENCE=novera-api

# Email identity
EMAIL_PROVIDER=development
EMAIL_FROM_EMAIL=no-reply@novera.local
EMAIL_FROM_NAME=Novera
EMAIL_REPLY_TO_EMAIL=

# Development provider
EMAIL_DEVELOPMENT_OUTBOX_DIR=var/email-outbox

# SMTP provider
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_STARTTLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_TIMEOUT_SECONDS=30

# Email worker
EMAIL_OUTBOX_MAX_ATTEMPTS=3
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_POLL_SECONDS=5
EMAIL_OUTBOX_STALE_AFTER_SECONDS=300
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_OUTBOX_RETRY_MAX_SECONDS=3600

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
